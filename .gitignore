# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
*.tsbuildinfo

# Environment variables (never commit secrets/connection strings)
.env
.env.*
!.env.example

# Local runtime data (JSON DB fallback, generated at startup — not source)
data/

# Generated Android package — contains the private APK signing keystore.
# Never commit a signing key; back it up somewhere private outside git instead.
android-package/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing / coverage
coverage/
playwright-report/
test-results/
playwright/.cache/

# Vite / bundler caches
.vite/
.cache/

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db
Desktop.ini

# Misc
*.tgz
*.tsbuildinfo
